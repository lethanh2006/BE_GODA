// Prisma schema — https://pris.ly/d/prisma-schema
// Connection URL được cấu hình trong prisma.config.ts (Prisma 7).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum JlptLevel {
  N5
  N4
  N3
  N2
  N1
}

/// Dạng bài (mondai) theo cấu trúc đề JLPT.
enum QuestionType {
  KANJI_READING // 漢字読み
  ORTHOGRAPHY // 表記
  WORD_FORMATION // 語形成
  CONTEXT // 文脈規定
  PARAPHRASE // 言い換え類義
  USAGE // 用法
  GRAMMAR_FORM // 文の文法1（文法形式の判断）
  SENTENCE_ORDER // 文の文法2（文の組み立て）
  TEXT_GRAMMAR // 文章の文法
  READING_SHORT // 内容理解（短文）
  READING_MEDIUM // 内容理解（中文）
  READING_LONG // 内容理解（長文）
  READING_INTEGRATED // 統合理解
  READING_THEMATIC // 主張理解（長文）
  INFO_RETRIEVAL // 情報検索
  LISTEN_TASK // 課題理解
  LISTEN_POINT // ポイント理解
  LISTEN_SUMMARY // 概要理解
  LISTEN_UTTERANCE // 発話表現
  LISTEN_RESPONSE // 即時応答
  LISTEN_INTEGRATED // 統合理解
}

enum UserRole {
  USER
  ADMIN
}

enum AttemptMode {
  EXAM // làm đề thi thử (có giờ, chấm cuối bài)
  PRACTICE // luyện tập (có thể xem đáp án ngay)
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum ReportStatus {
  OPEN
  RESOLVED
  REJECTED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  displayName  String
  role         UserRole   @default(USER)
  targetLevel  JlptLevel?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  attempts      Attempt[]
  bookmarks     Bookmark[]
  reports       QuestionReport[]
  questionStats UserQuestionStat[]
}

/// Bài đọc / đoạn văn dùng chung cho nhiều câu hỏi (読解, 文章の文法).
model Passage {
  id        String     @id
  level     JlptLevel
  title     String?
  content   String
  source    String
  questions Question[]
}

model Question {
  id           String       @id
  level        JlptLevel
  type         QuestionType
  /// Đề bài. Quy ước: 《...》 là phần gạch chân, （　） là chỗ trống, ★ là ô cần chọn (並べ替え).
  prompt       String
  options      String[]
  answerIndex  Int
  explanation  String?
  passageId    String?
  passage      Passage?     @relation(fields: [passageId], references: [id], onDelete: Cascade)
  passageOrder Int          @default(0)
  /// Nguồn dữ liệu: "goda" (biên soạn gốc) | "openjlpt".
  source       String
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  examQuestions ExamQuestion[]
  answers       AttemptAnswer[]
  bookmarks     Bookmark[]
  reports       QuestionReport[]
  userStats     UserQuestionStat[]

  @@index([level, type, isActive])
  @@index([passageId])
}

model Exam {
  id          String        @id @default(cuid())
  slug        String        @unique
  level       JlptLevel
  number      Int
  title       String
  description String?
  source      String
  published   Boolean       @default(true)
  createdAt   DateTime      @default(now())

  sections ExamSection[]
  attempts Attempt[]

  @@unique([level, number])
}

/// Một phần thi có giờ riêng, ví dụ 言語知識（文字・語彙）.
model ExamSection {
  id              String         @id @default(cuid())
  examId          String
  exam            Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  order           Int
  title           String
  titleVi         String
  durationMinutes Int

  questions ExamQuestion[]
  attempts  Attempt[]

  @@unique([examId, order])
}

model ExamQuestion {
  sectionId  String
  section    ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questionId String
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  /// Số thứ tự 問題 trong phần thi.
  mondai     Int

  @@id([sectionId, questionId])
  @@index([sectionId, order])
}

/// Một lượt làm bài (đề thi thử hoặc luyện tập). userId null = khách.
model Attempt {
  id               String        @id @default(cuid())
  userId           String?
  user             User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode             AttemptMode
  status           AttemptStatus @default(IN_PROGRESS)
  level            JlptLevel
  title            String
  examId           String?
  exam             Exam?         @relation(fields: [examId], references: [id], onDelete: SetNull)
  sectionId        String?
  section          ExamSection?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  /// Dạng bài khi luyện theo dạng (null = nhiều dạng).
  questionType     QuestionType?
  /// Thứ tự câu hỏi cố định của lượt làm.
  questionIds      String[]
  /// Bố cục: [{ title, titleVi, durationMinutes, mondai: [{ number, type, questionIds }] }].
  layout           Json
  instantFeedback  Boolean       @default(false)
  timeLimitSeconds Int?
  startedAt        DateTime      @default(now())
  submittedAt      DateTime?
  timeSpentSeconds Int?
  totalCount       Int
  correctCount     Int?
  scorePercent     Float?

  answers AttemptAnswer[]

  @@index([userId, status, submittedAt])
  @@index([examId])
}

model AttemptAnswer {
  attemptId     String
  attempt       Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedIndex Int?
  isCorrect     Boolean?
  flagged       Boolean  @default(false)
  /// Đã xem đáp án (chế độ luyện tập phản hồi ngay) — không cho đổi đáp án nữa.
  revealed      Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@id([attemptId, questionId])
  @@index([questionId])
}

/// Thống kê từng câu theo người dùng — dùng cho "ôn câu sai" và "ưu tiên câu chưa làm".
model UserQuestionStat {
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  seenCount      Int      @default(0)
  correctCount   Int      @default(0)
  lastCorrect    Boolean
  lastAnsweredAt DateTime

  @@id([userId, questionId])
  @@index([userId, lastCorrect])
}

model Bookmark {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, questionId])
  @@index([userId, createdAt])
}

model QuestionReport {
  id         String       @id @default(cuid())
  questionId String
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason     String
  message    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  @@index([questionId])
  @@index([status, createdAt])
}
