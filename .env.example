NODE_ENV=development
PORT=4000
# Khớp với docker-compose.yml (tài khoản goda / 123456)
DATABASE_URL=postgresql://goda:123456@localhost:5432/goda_jlpt
# Nhiều origin phân tách bằng dấu phẩy
CORS_ORIGIN=http://localhost:3000
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRES_DAYS=30
COOKIE_SECURE=false
